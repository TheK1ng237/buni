{
  "name": "@buni/ui",
  "version": "1.0.0",
  "description": "Buni Design System — React components built with Radix UI, Tailwind CSS v4 & Class Variance Authority",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "types": "./dist/styles.css.d.ts"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "tailwind-merge": ">=2.0.0",
    "lucide-react": ">=0.4.0",
    "@radix-ui/react-slot": ">=1.0.0",
    "@radix-ui/react-dialog": ">=1.0.0",
    "@radix-ui/react-dropdown-menu": ">=2.0.0",
    "@radix-ui/react-select": ">=2.0.0",
    "@radix-ui/react-tabs": ">=1.0.0",
    "@radix-ui/react-tooltip": ">=1.0.0",
    "@radix-ui/react-accordion": ">=1.0.0",
    "@radix-ui/react-alert-dialog": ">=1.0.0",
    "@radix-ui/react-avatar": ">=1.0.0",
    "@radix-ui/react-checkbox": ">=1.0.0",
    "@radix-ui/react-collapsible": ">=1.0.0",
    "@radix-ui/react-popover": ">=1.0.0",
    "@radix-ui/react-scroll-area": ">=1.0.0",
    "@radix-ui/react-separator": ">=1.0.0",
    "@radix-ui/react-switch": ">=1.0.0",
    "@radix-ui/react-toggle": ">=1.0.0",
    "@radix-ui/react-toggle-group": ">=1.0.0",
    "@radix-ui/react-progress": ">=1.0.0",
    "@radix-ui/react-label": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": false },
    "react-dom": { "optional": false },
    "tailwindcss": { "optional": false },
    "class-variance-authority": { "optional": true },
    "clsx": { "optional": true },
    "tailwind-merge": { "optional": true },
    "lucide-react": { "optional": true }
  },
  "keywords": [
    "ui",
    "react",
    "components",
    "design-system",
    "radix-ui",
    "tailwindcss",
    "buni",
    "african",
    "accessible"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buni/ui.git"
  },
  "homepage": "https://buni.dev/ui",
  "bugs": {
    "url": "https://github.com/buni/ui/issues"
  }
}